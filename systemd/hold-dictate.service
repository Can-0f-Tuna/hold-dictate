[Unit]
Description=Hold-to-dictate: hold Alt+Space to speak, release to paste the text
After=pipewire.service graphical-session.target
PartOf=graphical-session.target

[Service]
EnvironmentFile=-%h/.config/hold-dictate/env
ExecStart=%h/.local/share/hold-dictate/.venv/bin/python %h/.local/share/hold-dictate/dictate.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
